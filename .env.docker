# ============================================
# Coffee PDV - Docker Development Environment Variables
# ============================================
# This file is used by docker-compose.yml for local development
# Values here are SAFE DEFAULTS only - change as needed for your local setup
# DO NOT use this for production - use secrets manager instead
# ============================================

# === SPRING PROFILES ===
SPRING_PROFILES_ACTIVE=docker

# === PORTS ===
APP_PORT=8080
MYSQL_PORT=3306
RABBIT_PORT=5672

# === DATABASE (MySQL) ===
MYSQL_HOST=mysql
MYSQL_DATABASE=coffee
MYSQL_USER=coffee_user
MYSQL_PASSWORD=coffeepwd123

# Database connection pool
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5

# === SERVER ===
SERVER_PORT=8080
LOG_LEVEL=INFO

# === RABBITMQ ===
RABBIT_HOST=rabbitmq
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/

# RabbitMQ Exchange and Queue configuration
RABBITMQ_EXCHANGE=coffee.exchange
RABBITMQ_QUEUE=fechamento.caixa.queue
RABBITMQ_ROUTING_KEY=fechamento.caixa

# === SECURITY - JWT ===
# NOTE: For development only! Change this for production
# Generate a random key: openssl rand -base64 32
JWT_SECRET=your-development-secret-key-here-min-32-chars!
JWT_EXPIRATION_MS=86400000

# === CORS (if needed) ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4200

# === JAVA OPTIONS ===
JAVA_OPTS=-XX:+UseZGC -XX:MaxRAMPercentage=75.0

# === ADDITIONAL OPTIONS ===
TIMEZONE=America/Sao_Paulo

