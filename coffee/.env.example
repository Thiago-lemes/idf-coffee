# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=coffee
MYSQL_USER=coffee_user
MYSQL_PASSWORD=coffee_pass

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/coffee?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=coffee_user
SPRING_DATASOURCE_PASSWORD=coffee_pass

# JWT Configuration
JWT_SECRET=sua-chave-secreta-bem-segura-aqui
JWT_EXPIRATION_MS=86400000

# Server Configuration
SERVER_PORT=8080

# Production Only
# SPRING_PROFILES_ACTIVE=prod
