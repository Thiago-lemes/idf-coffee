# Exemplo de variáveis de ambiente para o profile dev-mysql
# Valores de exemplo — NÃO comitar credenciais reais no VCS

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=coffee
MYSQL_USER=root
MYSQL_PASSWORD=root

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# Opcional: configuração de exchange/queue (mapeadas no application-dev-mySql.yml)
RABBITMQ_EXCHANGE=coffee.exchange
RABBITMQ_QUEUE=fechamento.caixa.queue
RABBITMQ_ROUTING_KEY=fechamento.caixa

