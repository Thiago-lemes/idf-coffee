# ============================================
# Coffee PDV - Environment Variables Template
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env with real credentials to version control
# ============================================

# === SPRING PROFILE ===
# Options: dev-mysql, test, prod
SPRING_PROFILES_ACTIVE=dev-mysql

# === DATABASE (MySQL) ===
# Connection string format: jdbc:mysql://HOST:PORT/DATABASE
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/coffee?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Database connection pool settings
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5

# === SERVER ===
SERVER_PORT=8080
LOG_LEVEL=INFO

# === RABBITMQ ===
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# RabbitMQ Exchange and Queue configuration
RABBITMQ_EXCHANGE=coffee.exchange
RABBITMQ_QUEUE=fechamento.caixa.queue
RABBITMQ_ROUTING_KEY=fechamento.caixa

# === SECURITY - JWT ===
# JWT Secret key - MUST be at least 32 characters for production
# Generate: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000

# === SECURITY - CORS ===
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === SSL/HTTPS (Optional) ===
SSL_ENABLED=false
SSL_KEYSTORE_PATH=/path/to/keystore.p12
SSL_KEYSTORE_PASSWORD=keystore-password
SSL_KEY_ALIAS=tomcat
