# Copy to .env.prod and fill with real secrets before running in prod
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=coffee
MYSQL_USER=coffee_user
MYSQL_PASSWORD=change_me_db_password

# Spring datasource (optional override)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/coffee?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=coffee_user
SPRING_DATASOURCE_PASSWORD=change_me_db_password

# App settings
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JWT_SECRET=replace_with_a_secure_random_value
JWT_EXPIRATION_MS=86400000

