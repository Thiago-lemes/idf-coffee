# Cache-friendly Dockerfile for Maven projects located in a subdirectory
# Usage: docker build --build-arg APP_DIR=coffee -f Dockerfile.cache-friendly -t myapp .

FROM maven:3.9-eclipse-temurin-21 AS build

# Default to the common subdirectory where the Maven project lives
ARG APP_DIR=coffee
WORKDIR /app

# Copy only pom.xml first to leverage cache
COPY ${APP_DIR}/pom.xml ./pom.xml

# Download dependencies
RUN mvn -B -f pom.xml dependency:go-offline

# Copy source
COPY ${APP_DIR}/src ./src

# Build
RUN mvn -B -f pom.xml clean package -DskipTests

# Runtime image
FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache dumb-init \
    && addgroup -g 1000 spring \
    && adduser -u 1000 -G spring -s /bin/sh -D spring
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
RUN chown -R spring:spring /app
USER spring:spring
ENV PORT=8080
EXPOSE ${PORT}
ENTRYPOINT ["dumb-init", "--"]
CMD ["java", "-Xmx512m", "-Dserver.port=${PORT}", "-jar", "app.jar"]
