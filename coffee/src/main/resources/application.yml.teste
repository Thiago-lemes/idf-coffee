spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/coffee
    username: coffee_user
    password: coffee_pass
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect

api:
  security:
    token:
      secret: "change_this_to_a_strong_secret"
